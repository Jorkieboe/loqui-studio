{
  "name": "new-parley-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "backend": "uvicorn main:socket_app --host 127.0.0.1 --port 5000 --app-dir backend",
    "frontend": "vite frontend --host --config frontend/vite.config.mjs",
    "start": "concurrently \"npm run backend\" \"npm run frontend\"",
    "build": "cd frontend && vite build"
  },
  "dependencies": {
    "@vue-flow/background": "^1.3.0",
    "@vue-flow/controls": "^1.1.2",
    "@vue-flow/core": "^1.33.2",
    "@vueuse/core": "^10.9.0",
    "@vueuse/motion": "^2.1.0",
    "pinia": "^2.1.7",
    "socket.io-client": "^4.7.5",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0",
    "vue-tippy": "^6.4.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "concurrently": "^10.0.3",
    "vite": "^5.1.6"
  }
}
